# Upstream Go Backend
upstream backend_api {
    server backend:8080;
}

server {
    listen 80;
    server_name ${API_DOMAIN};

    # Docker internal DNS resolver for dynamically resolving upstreams like Supabase Kong
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $supabase_upstream http://kong:8000;

    client_max_body_size 50M;

    # 1. Supabase Auth Routing (/auth/v1/*)
    location /auth/v1/ {
        proxy_pass $supabase_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
        proxy_set_header X-Stage8-Media-Playback-Route "";
    }

    # 2. Supabase Storage Routing (/storage/v1/*)
    # Signed upload URLs contain bearer tokens in the query string. Keep access
    # and error logs off for both the exact route and denied media-video paths.
    location ~ "^/storage/v1/object/upload/sign/media-video/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\.mp4$" {
        access_log off;
        error_log /dev/null emerg;
        set $media_upload_enabled "${MEDIA_UPLOAD_ENABLED}";
        set $media_upload_route_key "${MEDIA_UPLOAD_ROUTE_KEY}";
        if ($media_upload_enabled != true) { return 404; }
        if ($media_upload_route_key = "") { return 404; }
        if ($request_method != PUT) { return 405; }
        client_max_body_size 80m;
        client_body_timeout 120s;
        send_timeout 120s;
        proxy_connect_timeout 5s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_pass $supabase_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
        proxy_set_header apikey "";
        proxy_set_header x-upsert "";
        proxy_set_header X-User-ID "";
        proxy_set_header X-Authenticated-User "";
        proxy_set_header X-Role "";
        proxy_set_header X-Forwarded-User "";
        proxy_set_header X-Forwarded-Roles "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Stage8-Media-Route $media_upload_route_key;
        proxy_set_header X-Stage8-Media-Playback-Route "";
    }
    location ~ ^/storage/v1/object/upload/sign/media-video/ {
        access_log off;
        error_log /dev/null emerg;
        return 404;
    }
    location ~* ^/storage/v1/object/sign/media-video(/.*)?$ {
        access_log off;
        error_log /dev/null emerg;
        return 404;
    }
    location /storage/v1/ {
        proxy_pass $supabase_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
        proxy_set_header X-Stage8-Media-Route "";
        proxy_set_header X-Stage8-Media-Playback-Route "";
    }

    # WS is unavailable in the base profile: never proxy an enabled handler
    # without the opt-in Unix verifier perimeter.
    location = /v1/ws {
        return 404;
    }

    # 4. Go Backend Business REST API (/v1/*)
    location /v1/ {
        proxy_pass http://backend_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
        proxy_set_header X-Stage8-Media-Playback-Route "";
    }

    # 5. Health check
    location /healthz {
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    # 6. Readiness check (Go Backend + Database Ping)
    location = /readyz {
        proxy_pass http://backend_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Stage8-Media-Playback-Route "";
    }
}
