# Opt-in P7 HTTP topology. HTTPS/WSS requires the separate P2 TLS profile;
# this template does not change the base deployment's HTTP/TLS defaults.
upstream backend_api {
    server backend:8080;
}
upstream auth_verifier {
    server unix:/run/iot-auth/auth.sock;
}

server {
    listen 80;
    server_name ${API_DOMAIN};
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $supabase_upstream http://kong:8000;
    client_max_body_size 50M;

    location /auth/v1/ {
        proxy_pass $supabase_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
    }
    location /storage/v1/ {
        proxy_pass $supabase_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
    }

    location = /_p7_ws_auth {
        internal;
        proxy_pass http://auth_verifier/internal/auth/verify/ws;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_pass_request_headers off;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Sec-WebSocket-Protocol $http_sec_websocket_protocol;
        proxy_set_header Content-Length "";
        proxy_connect_timeout 1s;
        proxy_send_timeout 3s;
        proxy_read_timeout 3s;
    }

    location = /v1/ws {
        auth_request /_p7_ws_auth;
        proxy_pass http://backend_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Sec-WebSocket-Protocol $http_sec_websocket_protocol;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-User-ID "";
        proxy_set_header X-Authenticated-User "";
        proxy_set_header X-Role "";
        proxy_set_header X-Forwarded-User "";
        proxy_set_header X-Forwarded-Roles "";
        proxy_set_header Forwarded "";
        proxy_buffering off;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }

    location /v1/ {
        proxy_pass http://backend_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
    }
    location = /healthz {
        return 200 'OK';
        add_header Content-Type text/plain;
    }
    location = /readyz {
        proxy_pass http://backend_api;
    }
    location / {
        return 404;
    }
}
