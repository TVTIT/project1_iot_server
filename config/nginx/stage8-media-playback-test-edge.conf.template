# Fixture-only HTTPS edge that models public TLS termination and reaches the
# internal Nginx playback listener (port 8081) over HTTP.
server {
    listen 443 ssl;
    server_name localhost;
    ssl_certificate /etc/nginx/stage8-tls/server.crt;
    ssl_certificate_key /etc/nginx/stage8-tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1k;
    access_log off;
    error_log /dev/null emerg;
    resolver 127.0.0.11 valid=5s ipv6=off;
    set $playback_upstream http://stage8-shared-nginx:8081;

    location / {
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_pass $playback_upstream;
        proxy_set_header Host $host;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
