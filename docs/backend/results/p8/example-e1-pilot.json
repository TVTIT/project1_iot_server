{
  "schema_version": 1,
  "experiment": "E1",
  "arm": "reference",
  "profile": "pilot",
  "mode": "remote",
  "run_id": "example-e1-pilot",
  "seed": 841,
  "roles": ["viewer"],
  "samples_per_message": 100,
  "topology": {"gateways": 2, "sensors_per_gateway": 2, "users": 2, "viewers": 2},
  "targets": [
    {"gateway_id": "gw-a", "sensor_id": "sensor-a"},
    {"gateway_id": "gw-a", "sensor_id": "sensor-aa"},
    {"gateway_id": "gw-b", "sensor_id": "sensor-b"},
    {"gateway_id": "gw-b", "sensor_id": "sensor-bb"}
  ],
  "subscriptions": [
    {"viewer_id": "viewer-a", "user_id": "user-a", "gateway_id": "gw-a", "sensor_id": "sensor-a"},
    {"viewer_id": "viewer-a", "user_id": "user-a", "gateway_id": "gw-a"},
    {"viewer_id": "viewer-b", "user_id": "user-b", "gateway_id": "gw-b", "sensor_id": "sensor-b"}
  ],
  "traffic": {"rate_per_second": 10, "ramp_seconds": 5, "burst_messages": 20},
  "phases": {"warmup_seconds": 30, "measure_seconds": 120, "drain_seconds": 120, "cooldown_seconds": 30},
  "limits": {"retries": 2, "workers": 4, "connections": 64, "pending_messages": 10000, "pending_bytes": 67108864, "disk_growth_bytes": 2147483648, "wall_seconds": 600},
  "tls": {"https_endpoint": "https://localhost:18443", "mqtt_tls_endpoint": "mqtts://localhost:18884", "https_ca_file": "bundle/https-ca.pem", "mqtt_tls_ca_file": "bundle/mqtt-ca.pem"},
  "identity_files": {"viewer": "bundle/private/viewer.json"},
  "bundle_path": "bundle",
  "retry_interval_ms": 1000,
  "publish_timeout_ms": 5000
}
