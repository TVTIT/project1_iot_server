# ==============================================================================
# IoT Gateway-Server Environment Configuration
# ==============================================================================

# Server & Domain Config
API_DOMAIN=localhost
SERVER_PORT=8080
SERVER_ENV=development
# Opt-in bounded metrics; GET /v1/admin/metrics still requires platform-admin JWT.
METRICS_ENABLED=false
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1
DATABASE_CONNECT_TIMEOUT=10s
READINESS_TIMEOUT=2s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
# HTTP and shutdown budgets must accommodate credential operations when enabled:
# HTTP_WRITE_TIMEOUT must exceed AUTHORIZATION_TIMEOUT (2s) + MQTT_CREDENTIAL_REQUEST_TIMEOUT (40s) + MQTT_CREDENTIAL_RECOVERY_TIMEOUT (5s) = 47s.
# SHUTDOWN_TIMEOUT must exceed MQTT_CREDENTIAL_REQUEST_TIMEOUT (40s) + MQTT_CREDENTIAL_RECOVERY_TIMEOUT (5s) = 45s.
# Safe bounded values (55s) satisfy enabled validation checks while remaining configurable.
HTTP_WRITE_TIMEOUT=55s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=55s

# Configurable CORS allowed origins (comma-separated exact web origins).
# Empty or missing disables cross-origin permission while allowing direct server requests.
# Supported operator inputs: localhost, ordinary ASCII DNS names (or punycode),
# and standard four-part decimal IPv4 addresses, e.g. http://127.0.0.1:12345.
# Do not configure abbreviated, hexadecimal, integer or leading-zero IPv4 forms,
# numeric-terminal DNS names, or IPv6 origins; their browser compatibility is not qualified.
# This is a documented configuration restriction, not additional parser enforcement.
# Include http:// or https://; omit paths and trailing slashes. No wildcard origins.
# Safe development example for fixed Flutter Web development port: http://localhost:12345
# Production operators configure their HTTPS web origin explicitly (e.g. https://dashboard.example.com); do not hard-code real domains.
CORS_ALLOWED_ORIGINS=http://localhost:12345

# Support development, tcp_tunnel, http_tunnel, production
COMPOSE_PROFILES=development

# Cloudflare Tunnel (Token from Cloudflare Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

# PostgreSQL & TimescaleDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=iot_platform
POSTGRES_PORT=5432
BACKEND_DB_PASSWORD=replace_with_url_safe_backend_database_password

# Password in DATABASE_URL need to same as BACKEND_DB_PASSWORD, not POSTGRES_PASSWORD
DATABASE_URL=postgres://iot_backend_app:replace_with_url_safe_backend_database_password@postgres:5432/iot_platform?sslmode=disable

# URL-safe random values: letters, digits, dot, underscore, tilde, hyphen.
AUTH_DB_PASSWORD=replace_with_url_safe_auth_database_password
STORAGE_DB_PASSWORD=replace_with_url_safe_storage_database_password

# MQTT Mosquitto
MQTT_BROKER_URL=ssl://mosquitto:8883
MQTT_CLIENT_ID=go_backend_server
MQTT_USERNAME=backend_service
MQTT_PASSWORD=replace_with_backend_mqtt_password

# MQTT telemetry ingress data client. Opt-in and independent of the credential API
# and the legacy runtime flag. When false, no data credential or CA is required.
# When true, MQTT_BROKER_URL/CLIENT_ID/USERNAME/PASSWORD/TLS_CA_FILE must be set;
# MQTT_BROKER_URL must be an ssl:// URL with no userinfo, path, query or fragment.
MQTT_INGRESS_ENABLED=false

# Legacy static auth/reloader runtime is disabled for the native DynSec topology.
MQTT_CREDENTIAL_RUNTIME_ENABLED=false

# Dynamic Security credential API remains false by default pending offline bootstrap
# delivery of the initial dynamic-security.json store file and prerequisite credentials.
MQTT_CREDENTIAL_API_ENABLED=false
INGRESS_GATE_ENABLED=true

# Distinct manager credentials for Dynamic Security management operations.
# Required manager inputs cannot default to a known secret or match the backend credential.
MQTT_DYNSEC_MANAGER_USERNAME=credential_manager
MQTT_DYNSEC_MANAGER_PASSWORD=replace_with_distinct_manager_mqtt_password

# Management URL points to the real Mosquitto TLS listener (no synthetic management port).
MQTT_INTERNAL_MANAGEMENT_URL=ssl://mosquitto:8883

# Native store snapshot path inside dedicated volume mount.
# Backend mounts this directory read-only; no private key or store write permission.
MQTT_DYNSEC_JSON_PATH=/mosquitto/dynsec/dynamic-security.json

# Named Docker volume contains store Dynamic Security gathered from script bootstrap container.
# Default is 'mosquitto_dynsec'. More details: docs/runbooks/mqtt-dynsec-bootstrap.md
MQTT_DYNSEC_BOOTSTRAP_VOLUME=

# Required writer UID when credential API is enabled: must be an explicit base10 uint32.
# For this selected topology (1883:1883), configured writer UID must match actual container
# namespace ownership of the native store (1883 for eclipse-mosquitto:2.0.18), not host guesswork.
MQTT_DYNSEC_WRITER_UID=1883

# Native Dynamic Security qualification descriptor.
# Binds operator/release identity to the tested and qualified Mosquitto image/digest/platform.
# This is a composition-time release binding, not a runtime remote broker attestation.
MQTT_DYNSEC_IMAGE_REFERENCE=eclipse-mosquitto@sha256:d12c8f80dfc65b768bb9acecc7ef182b976f71fb681640b66358e5e0cf94e9e9
MQTT_DYNSEC_IMAGE_CONFIG_ID=sha256:d25945831d6b8935b016caacc6f612ad4876ba124601b240e64953886cf264b4
MQTT_DYNSEC_PLATFORM=linux/amd64

# DynSec client and credential budget timeouts (bounded values satisfying budget checks).
MQTT_DYNSEC_TIMEOUT=3s
MQTT_DYNSEC_QUEUE_SIZE=16
MQTT_DYNSEC_MAX_INFLIGHT=1
MQTT_DYNSEC_MAX_PAYLOAD_BYTES=65536
MQTT_DYNSEC_MAX_SNAPSHOT_BYTES=1048576

MQTT_CREDENTIAL_DB_TIMEOUT=2s
MQTT_CREDENTIAL_FINALIZE_TIMEOUT=5s
MQTT_CREDENTIAL_RECONCILE_TIMEOUT=2m
MQTT_CREDENTIAL_RECONCILE_BATCH_SIZE=64
MQTT_CREDENTIAL_RECONCILE_MAX_PAGES=16
MQTT_CREDENTIAL_OPERATION_TIMEOUT=10s
MQTT_CREDENTIAL_REQUEST_TIMEOUT=40s
MQTT_CREDENTIAL_RECOVERY_TIMEOUT=5s

# Host public CA file only (not the directory containing broker private keys).
MQTT_TLS_CA_SOURCE=./config/mosquitto/certs/ca.crt
# Container target; Compose mounts the public CA at this exact path.
MQTT_TLS_CA_FILE=/mosquitto/config/certs/ca.crt

MQTT_QUEUE_CAPACITY=256
MQTT_WORKER_COUNT=4
# Application-level payload limit. Default/demo profile is 64 KiB; the supported
# maximum is 1 MiB (1048576). MQTT_QUEUE_CAPACITY x MQTT_MAX_PAYLOAD_BYTES is the
# dominant in-memory queue budget: default 16 MiB, supported maximum 256 MiB.
MQTT_MAX_PAYLOAD_BYTES=65536

# Telemetry validation bounds and the repository DB transaction budget.
TELEMETRY_MAX_SAMPLES_PER_MESSAGE=1000
TELEMETRY_MAX_BATCH_DURATION=60s
TELEMETRY_MAX_FUTURE_SKEW=2m
TELEMETRY_DB_TIMEOUT=5s

# MQTT ingress connect, subscription, publish and reconnect bounds.
MQTT_CONNECT_TIMEOUT=5s
MQTT_SUBSCRIBE_TIMEOUT=3s
MQTT_PUBLISH_TIMEOUT=3s
MQTT_RECONNECT_MAX_INTERVAL=30s

# External / Public Broker Domain for TLS Certificate (SAN)
MQTT_BROKER_DOMAIN=localhost
# Optional comma-separated additional domains or IPs for TLS SAN (e.g. tunnel.example.com,192.168.1.100)
MQTT_ADDITIONAL_SAN=

# Supabase Auth & JWT Configuration
# Note: JWT_SECRET must be at least 32 characters long.
JWT_SECRET=replace_with_random_secret_of_at_least_32_characters
JWT_EXPIRY=3600
SUPABASE_PUBLIC_URL=http://localhost
# Must match the iss claim issued by GoTrue; use the public Auth URL for each deployment.
GOTRUE_JWT_ISSUER=http://localhost/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_CLOCK_SKEW=30s
AUTHORIZATION_TIMEOUT=2s
ADMIN_MAX_BODY_BYTES=16384

# API keys must match JWT_SECRET; see Auth docs. Never pass a signing secret via argv.
ANON_KEY=replace_with_generated_anon_key
SERVICE_ROLE_KEY=replace_with_generated_service_role_key

# Supabase GoTrue Auth Service
GOTRUE_SITE_URL=http://localhost
# Centralized MVP: keep true; accounts are created/invited by protected admin tooling.
GOTRUE_DISABLE_SIGNUP=true
GOTRUE_MAILER_AUTOCONFIRM=true

# Supabase Storage Configuration (Local Filesystem)
GLOBAL_S3_BUCKET=iot-storage
MEDIA_STORAGE_BUCKET=media-images

# ==============================================================================
# Stage 4 Read Bounds (History & Digital Twin)
# ==============================================================================
# Bounded read query bounds and deadlines matching Stage 4 API contract.
# HISTORY_QUERY_TIMEOUT: deadline applied across resource resolution and data reads (contract default 5s).
HISTORY_QUERY_TIMEOUT=5s
# HISTORY_MAX_RANGE: maximum query time range window (contract hard cap 744h / 31d).
HISTORY_MAX_RANGE=744h
# HISTORY_RAW_WINDOW: maximum window for explicit raw resolution queries (contract hard cap 10s).
HISTORY_RAW_WINDOW=10s
# HISTORY_DEFAULT_POINTS: default max points when unspecified in history query (contract default 1000).
HISTORY_DEFAULT_POINTS=1000
# HISTORY_MAX_POINTS: upper limit for requested points in history query (contract hard cap 2000).
HISTORY_MAX_POINTS=2000
# HISTORY_MIN_POINTS: lower limit for requested points in history query (contract min 100).
HISTORY_MIN_POINTS=100

# TWIN_LIST_DEFAULT_LIMIT: default page limit for GET /v1/digital-twins (contract default 50).
TWIN_LIST_DEFAULT_LIMIT=50
# TWIN_LIST_MAX_LIMIT: maximum page limit for GET /v1/digital-twins (contract hard cap 200).
TWIN_LIST_MAX_LIMIT=200
# TWIN_RELATIONSHIP_DEFAULT_LIMIT: default page limit for relationships (contract default 50).
TWIN_RELATIONSHIP_DEFAULT_LIMIT=50
# TWIN_RELATIONSHIP_MAX_LIMIT: maximum page limit for relationships (contract hard cap 200).
TWIN_RELATIONSHIP_MAX_LIMIT=200

# ==============================================================================
# Gateway Simulator (Stage 3, Task 3.5) — development/integration tooling only
# ==============================================================================
# The simulator uses its own GATEWAY_* loader and never reads DATABASE_URL or
# Supabase settings. Values below are safe placeholders; never commit real MQTT
# passwords, CA private keys, domains, or personal values. See
# docs/backend/stage-3-task-3.5-gateway-simulator.md for run/pending/count/quarantine usage.
# The target Gateway and Sensor must already be provisioned on the server; the
# simulator never auto-provisions entities.

# Required identity. GATEWAY_MQTT_USERNAME must equal GATEWAY_ID; GATEWAY_MQTT_CLIENT_ID must differ from it.
GATEWAY_ID=gateway_001
SENSOR_ID=sensor_001

# Required MQTT/TLS settings. Broker URL must be an ssl:// URL with host and port.
GATEWAY_MQTT_BROKER_URL=ssl://mosquitto:8883
GATEWAY_MQTT_CLIENT_ID=gateway_001_sim
GATEWAY_MQTT_USERNAME=gateway_001
GATEWAY_MQTT_PASSWORD=replace_with_per_gateway_mqtt_password
# Public CA file only (not the broker private key). Must be a clean absolute path.
GATEWAY_MQTT_CA_FILE=/absolute/path/to/public/ca.crt

# Required durable SQLite outbox file. Must be a clean absolute path (not :memory:).
GATEWAY_OUTBOX_PATH=/absolute/path/to/gateway_001_outbox.db

# Optional synthetic sample profile (defaults shown) and bounded limits.
GATEWAY_SAMPLE_RATE_HZ=100
GATEWAY_SAMPLES_PER_BATCH=100
GATEWAY_ACK_TIMEOUT=5s
GATEWAY_RETRY_MIN_DELAY=1s
GATEWAY_RETRY_MAX_DELAY=30s
GATEWAY_MAX_INFLIGHT=8
GATEWAY_OUTBOX_MAX_ROWS=5000
GATEWAY_OUTBOX_MAX_BYTES=67108864

# Optional operation timeouts (defaults shown).
GATEWAY_MQTT_CONNECT_TIMEOUT=10s
GATEWAY_MQTT_SUBSCRIBE_TIMEOUT=5s
GATEWAY_MQTT_PUBLISH_TIMEOUT=5s
GATEWAY_SQLITE_TIMEOUT=5s
GATEWAY_SHUTDOWN_TIMEOUT=10s

# ==============================================================================
# Admin User Management & Auth Admin Configuration
# ==============================================================================
# Base URL of the Supabase API Gateway (Envoy) reachable by the backend.
# In Docker Compose, this defaults to http://supabase-envoy:8000.
# In local native execution, point to http://localhost/auth/v1 or http://127.0.0.1:8000.
SUPABASE_URL=http://localhost
# Optional override for Auth Admin base URL.
AUTH_ADMIN_BASE_URL=
# Service role key used by the backend to call the Supabase Auth Admin API (CreateUser).
# Reuses SERVICE_ROLE_KEY if unset. Never commit real privileged keys.
SUPABASE_SERVICE_ROLE_KEY=
# Timeout for administrative user management operations (default 10s, bounds 100ms-60s).
AUTH_ADMIN_TIMEOUT=10s
# Maximum response body size for Auth Admin HTTP adapter (default 16384, bounds 1-1048576).
AUTH_ADMIN_MAX_BODY_BYTES=16384
# Capacity bounds for GET /v1/admin/users
USER_LIST_MAX_USERS=1000
USER_LIST_MAX_MEMBERSHIPS=10000
USER_LIST_MAX_RESPONSE_BYTES=2097152
# Stage 5: Sensor intent/query API, bounded publisher and expiry (default OFF).
# Result ingestion and Gateway command execution are not implemented at this checkpoint.
# Task 5.3 does NOT start MQTT publish/results or a global expiry worker.
# Enable only in an isolated rehearsal until Tasks 5.4–5.6 are integrated.
# Requires migration 23 and runtime iot_backend grants. Never equate 202 with apply.
STAGE5_ENABLED=false
STAGE5_REQUEST_TIMEOUT=5s
STAGE5_COMMAND_TTL=60s
STAGE5_MAX_PENDING_OUTBOX=10000
STAGE5_MAX_RECEIPTS=100000
# Task 5.4: backend publisher/expiry only; Gateway apply/result confirmation are
# later tasks. Enabling requires exact ACL readback using the distinct manager
# above, EVEN WITH MQTT_CREDENTIAL_API_ENABLED=false. The code reads only, but
# that credential has management mutation authority: protect it accordingly.
STAGE5_MQTT_CLIENT_ID=backend_control
STAGE5_PUBLISH_WORKERS=1
STAGE5_SCAN_BATCH=32
STAGE5_RESULT_QUEUE=128
# Fixed protocol cap, not a broker-limit increase.
STAGE5_PAYLOAD_BYTES=8192
STAGE5_SCAN_INTERVAL=1s
STAGE5_EXPIRE_INTERVAL=1s
STAGE5_RETRY_BACKOFF=1s
STAGE5_PUBLISH_TIMEOUT=3s
STAGE5_ACL_TIMEOUT=5s
STAGE5_CONNECT_TIMEOUT=5s
STAGE5_SUBSCRIBE_TIMEOUT=3s
STAGE5_RECONNECT_MAX_INTERVAL=30s
