# Server & Domain Config
API_DOMAIN=localhost
SERVER_PORT=8080
SERVER_ENV=development

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=eyJhSWoiOiI...

# PostgreSQL & TimescaleDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=iot_platform
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:your_secure_postgres_password@postgres:5432/iot_platform?sslmode=disable

# MQTT Mosquitto
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_CLIENT_ID=go_backend_server
MQTT_USERNAME=backend_service
MQTT_PASSWORD=backend_secret

# Supabase Auth & Storage Config
SUPABASE_JWT_SECRET=your_super_secret_jwt_token_min_32_chars_long
SUPABASE_URL=http://kong:8000
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# FL Config
FL_MODEL_STORAGE_BUCKET=fl-models
FL_WEIGHT_STORAGE_BUCKET=fl-weights
